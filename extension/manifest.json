{
  "manifest_version": 3,
  "name": "Trakt Titles",
  "version": "1.4.3",
  "description": "Restores missing titles on poster-only Trakt cards, keeps official bilingual titles on smart lists, search and discover pages, localizes show and episode titles on tvtime.trakt.tv, and translates titles and overviews on og.trakt.tv.",
  "homepage_url": "https://github.com/lunanfo/TraktTitles",
  "icons": {
    "16": "icons/trakt-circlemark-16.png",
    "32": "icons/trakt-circlemark-32.png",
    "48": "icons/trakt-circlemark-48.png",
    "128": "icons/trakt-circlemark-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trakt.tv/*",
        "https://app.trakt.tv/*",
        "https://tvtime.trakt.tv/*",
        "https://og.trakt.tv/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://trakt.tv/*",
        "https://app.trakt.tv/*",
        "https://tvtime.trakt.tv/*",
        "https://og.trakt.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Trakt Titles",
    "default_icon": {
      "16": "icons/trakt-circlemark-16.png",
      "32": "icons/trakt-circlemark-32.png",
      "48": "icons/trakt-circlemark-48.png",
      "128": "icons/trakt-circlemark-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.trakt.tv/*"
  ]
}
